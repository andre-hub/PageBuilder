# Apache 2.4: serve generated pages and public assets only.
Options -Indexes -MultiViews
ErrorDocument 404 default
RewriteEngine On

# Never expose repository metadata, generator inputs or executable files.
RewriteRule (^|/)\. - [R=404,END]
RewriteRule ^(?:builder|pages|deploy|scripts|docs)(?:/|$) - [R=404,END,NC]
RewriteRule \.(?:php[0-9]*|phtml|phar)(?:/|$) - [R=404,END,NC]

# The demo occupies the domain root, which may be mapped through an Apache Alias.
# Re-enter routing after rewriting; the public-file allowlist checks the real path.
RewriteRule ^$ /html/index.html [L]

# Asset aliases used by generated HTML and theme stylesheets.
RewriteRule ^(css|img|js|fonts|themes)/([A-Za-z0-9_./-]+\.(?:css|js|png|jpe?g|gif|webp|svg|ico|woff2?|ttf|otf|eot|txt))$ /static/$1/$2 [L]

# Only existing generated pages are eligible for clean URLs.
RewriteRule ^([A-Za-z0-9_-]+)$ /html/$1.html [L]

# Direct public-file URLs remain usable, but arbitrary existing repo files do not.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(?:html/[A-Za-z0-9_-]+\.html|static/(?:css|img|js|fonts|themes)/[A-Za-z0-9_./-]+\.(?:css|js|png|jpe?g|gif|webp|svg|ico|woff2?|ttf|otf|eot|txt)|favicon\.(?:ico|png)|robots\.txt|sitemap\.xml)$ - [END]

RewriteRule ^ - [R=404,END]
